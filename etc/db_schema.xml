<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="cms_page" resource="default" engine="innodb" comment="CMS Page Table">
        <column xsi:type="varchar" name="og_title" nullable="true" length="255" comment="Open Graph Title"/>
        <column xsi:type="text" name="og_description" nullable="true" comment="Open Graph Description"/>
        <column xsi:type="varchar" name="og_image" nullable="true" length="255" comment="Open Graph Image"/>
    </table>
</schema>
